# Minimal `.dev.vars` template for local `wrangler dev`.
# Copy to `.dev.vars` (gitignored) and fill in real values — never commit them.
# Production receives these as wrangler secrets (see .github/workflows/deploy.yml).
# SESSION_SECRET: signs the nav_session cookie (HS256)
SESSION_SECRET=replace-with-a-long-random-string
# SETUP_SECRET: one-time token for creating the owner account
SETUP_SECRET=replace-with-a-long-random-setup-token
# TABLE_PREFIX (optional): leave unset to use the project default "nav_";
# "none" or empty for no prefix; otherwise a lowercase/digits/underscore
# prefix (a trailing "_" is recommended). wrangler dev reads .dev.vars as env
# vars, overriding any committed binding.
# TABLE_PREFIX=nav_
