{
  "name": "worker",
  "private": true,
  "type": "module",
  "scripts": {
    "codegen": "node scripts/gen-schema.mjs",
    "dev": "pnpm codegen && wrangler dev",
    "build": "pnpm codegen && tsc --noEmit",
    "typecheck": "pnpm codegen && tsc --noEmit",
    "test": "pnpm codegen && vitest run",
    "deploy": "pnpm codegen && wrangler deploy"
  },
  "dependencies": {
    "@simplewebauthn/server": "^14.0.0",
    "hono": "^4.7.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "typescript": "^7.0.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.14.1"
  }
}
